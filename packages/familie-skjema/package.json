{
    "version": "8.2.50",
    "name": "@navikt/familie-skjema",
    "type": "module",
    "author": "NAV",
    "homepage": "https://github.com/navikt/familie-felles-frontend#readme",
    "repository": {
        "type": "git",
        "url": "https://github.com/navikt/familie-felles-frontend"
    },
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "module": "dist/index.js",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "pnpm run clean && pnpm run copy-less && pnpm run tsc  && pnpm run tsc-alias",
        "clean": "rm -rf ./dist",
        "copy-less": "copyfiles -u 1 src/**/*.less dist",
        "tsc": "tsc -p tsconfig.json",
        "tsc-alias": "tsc-alias -p tsconfig.json"
    },
    "dependencies": {
        "@navikt/familie-http": "^8.0.24",
        "@navikt/familie-typer": "^8.0.6",
        "@types/deep-equal": "1.0.4",
        "deep-equal": "2.2.3",
        "hashids": "2.3.0"
    },
    "devDependencies": {
        "tsc-alias": "1.9.0"
    },
    "peerDependencies": {
        "react": "18.x || 19.x"
    }
}
